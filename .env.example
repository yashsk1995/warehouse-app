# =========================================
# CORE
# =========================================
NODE_ENV=development
ENV_DEV=true
PORT=6000
API_BASE_URL=http://localhost:6000

# =========================================
# DATABASE (MySQL on AWS RDS in prod)
# =========================================
DATABASE_URL="mysql://root:root@localhost:3306/warehouse"

# =========================================
# AUTH
# =========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotate per environment (dev / staging / prod must each have unique values).
JWT_SECRET=replace-with-48-byte-base64
JWT_REFRESH_SECRET=replace-with-different-48-byte-base64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# =========================================
# REDIS (BullMQ)
# =========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =========================================
# AWS (S3 in prod)
# =========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=warehouse-inventory-uploads

# =========================================
# OCR + AI
# =========================================
# Provider: openai | google-vision | aws-textract
OCR_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# Google Vision (optional)
GOOGLE_APPLICATION_CREDENTIALS=

# =========================================
# ZOHO INVENTORY
# =========================================
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_API_BASE=https://www.zohoapis.com/inventory/v1
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com

# =========================================
# UPLOADS
# =========================================
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# =========================================
# RATE LIMITING
# =========================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# =========================================
# LOGGING
# =========================================
LOG_LEVEL=info
