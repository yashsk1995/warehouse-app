# pnpm config — hoist node_modules so React Native / Expo can resolve packages
# the way they expect (flat, npm-style). Required for EAS Build to succeed in a
# pnpm monorepo: gradlew runs `require.resolve('react-native/package.json')` and
# pnpm's default isolated layout returns null, breaking the Android build.
node-linker=hoisted
public-hoist-pattern[]=*
